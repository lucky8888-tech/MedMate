# SafeDose environment variables.
# Copy this file to ".env" for local use. Never commit your real .env.

# Flask secret key. Use a long random string in production.
SECRET_KEY=dev-secret-key-change-in-production

# 1 = local dev mode (debug on), 0 = production.
FLASK_DEBUG=1

# Port the server listens on. Hosting platforms set this automatically.
PORT=5000

# Host to bind. Use 0.0.0.0 in production; 127.0.0.1 for local-only access.
HOST=127.0.0.1

# Local file where feedback submissions are stored. Do not commit this file.
FEEDBACK_FILE=feedback.json
